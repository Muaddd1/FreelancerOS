# PostgreSQL connection string (Neon, Supabase, local Postgres...)
DATABASE_URL="postgresql://user:password@localhost:5432/freelanceros"

# NextAuth: a long random string (openssl rand -base64 32) and the app's public URL
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: Gumroad sale webhook (/api/webhook/gumroad). Empty = signature check skipped (dev only).
GUMROAD_WEBHOOK_SECRET=""
# Optional: Resend API key for the login email sent after a Gumroad sale (link uses NEXTAUTH_URL). Empty = no email.
RESEND_API_KEY=""
